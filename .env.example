# Proposed Rulebreak variables. Empty secrets are deliberate.
RULEBREAK_HOST=127.0.0.1
RULEBREAK_PORT=4000
RULEBREAK_DATA_DIR=.rulebreak
RULEBREAK_LIVE_ENABLED=false
RULEBREAK_PROVIDER=grok
RULEBREAK_MODEL=
RULEBREAK_MAX_WORKERS=2
RULEBREAK_MAX_TOOL_CALLS=200
RULEBREAK_MAX_MUTATIONS=100
RULEBREAK_MAX_CAMPAIGN_SECONDS=600
RULEBREAK_MAX_TOKENS=60000
RULEBREAK_MAX_COST_USD=5
# Required for POST /api/campaigns and POST .../stop. Vite proxy injects it for local UI.
# Example local value (never commit a real secret): local-dev-operator
RULEBREAK_OPERATOR_TOKEN=

# Existing upstream variable; set an absolute, dedicated path in local setup.
AGENC_HOME=

# Set only for the chosen approved provider; never commit a real value.
XAI_API_KEY=

# Thor SSH live-ish path (RB-011). Networked local LLM; paid cloud hard cap $0.
# Secrets stay in gitignored .env only. SSH ≠ G4 containment.
THOR_SSH_HOST=thor.atr.cs.kent.edu
THOR_SSH_USER=marnett5
THOR_SSH_PASSWORD=
# Optional remote LLM probe on Thor loopback (default: Ollama /api/tags).
# THOR_LLM_PROBE_CMD=curl -sS --max-time 30 http://127.0.0.1:11434/api/tags
# Optional model for dual-agent generate turns (default llama3:8b / first Thor tag).
# THOR_OLLAMA_MODEL=llama3:8b
