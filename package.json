{
  "name": "rulebreak",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Adversarial multiagent framework for testing game economies",
  "engines": {
    "node": ">=26.5.0 <27.0.0",
    "npm": ">=11.17.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preflight": "node ./scripts/preflight.mjs",
    "build": "npm run typecheck",
    "lint": "node ./scripts/preflight.mjs --lint-placeholder",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "node ./scripts/not-implemented.mjs test:e2e",
    "test:security": "node ./scripts/not-implemented.mjs test:security",
    "test:agenc": "node ./scripts/spikes/rb-003-mcp-direct.mjs",
    "demo:offline": "node ./scripts/demo-offline.mjs",
    "demo:live": "node ./scripts/not-implemented.mjs demo:live",
    "replay": "node ./scripts/not-implemented.mjs replay",
    "benchmark": "node ./scripts/not-implemented.mjs benchmark",
    "spike:rb003": "node ./scripts/spikes/rb-003-mcp-direct.mjs",
    "dev:web": "npm run dev -w @rulebreak/web",
    "build:web": "npm run build -w @rulebreak/web",
    "dev:server": "npm run start -w @rulebreak/server",
    "dev:ui": "npm run dev:server & npm run dev:web",
    "ci:offline": "node ./scripts/ci-offline.mjs",
    "spike:g2g4": "node ./scripts/spikes/g2-g4-offline-probes.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^4.1.5",
    "@tetsuo-ai/agenc": "0.17.0",
    "@tetsuo-ai/agenc-sdk": "file:./vendor/agenc-sdk-0.3.0-v017"
  }
}
